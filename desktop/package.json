{
  "name": "financial-risk-warning-desktop",
  "productName": "财务风险智能预警平台",
  "version": "1.0.0",
  "description": "财务风险智能预警平台 · Windows / macOS / Linux 桌面端（Electron + FastAPI + Vue）",
  "main": "main.js",
  "private": true,
  "author": "financial-risk-warning-platform",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env RWP_DEV=1 electron .",
    "smoke": "cross-env RWP_SMOKE=1 electron .",
    "smoke:window": "cross-env RWP_SMOKE=2 electron .",
    "build:web": "node scripts/build-web.js",
    "build:backend": "node scripts/build-backend.js",
    "dist": "node scripts/build-web.js && node scripts/build-backend.js && electron-builder --win --x64",
    "dist:dir": "node scripts/build-web.js && node scripts/build-backend.js && electron-builder --win --x64 --dir",
    "dist:mac": "node scripts/build-web.js && node scripts/build-backend.js && electron-builder --mac"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.finrisk.warning",
    "productName": "FinancialRiskWarningPlatform",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources/web", "to": "web" },
      { "from": "resources/backend", "to": "backend" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "FinancialRiskWarningPlatform-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "财务风险智能预警平台",
      "artifactName": "FinancialRiskWarningPlatform-${version}-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "FinancialRiskWarningPlatform-${version}-${arch}-Portable.${ext}"
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [{ "target": "dmg" }, { "target": "zip" }],
      "artifactName": "FinancialRiskWarningPlatform-${version}-mac-${arch}.${ext}"
    }
  }
}
