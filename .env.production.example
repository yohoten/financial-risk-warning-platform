# 财务风险智能预警平台 · 生产环境变量模板
# 用法：cp .env.production.example .env 后按需填写；compose 读取同目录 .env。

# ---- 认证与权限（生产强制 full）----
RISK_AUTH_MODE=full
# JWT 签名密钥：缺失时自动随机生成并持久化到 cache/.auth_secret（重启不失效）；
# 生产建议显式指定（openssl rand -hex 32）。
RISK_AUTH_SECRET=
RISK_ADMIN_USERNAME=admin
RISK_ADMIN_EMAIL=admin@example.com
# 初始管理员口令（首启播种；不设则用演示弱口令 admin12345 并强制首次改密）
RISK_ADMIN_PASSWORD=
RISK_ACCESS_TOKEN_MINUTES=30
RISK_REFRESH_TOKEN_DAYS=7
RISK_LOGIN_MAX_ATTEMPTS=5
RISK_LOGIN_LOCK_MINUTES=15
RISK_LOGIN_RATE_LIMIT=10
RISK_PASSWORD_MIN_LENGTH=8

# ---- CORS（生产填真实域名，逗号分隔）----
RISK_CORS_ORIGINS=https://your-domain.example.com

# ---- 存储 / 服务 ----
# 令牌黑名单 / 事件（Redis；不设则退化为 SQLite + 进程内内存，单机可跑）
REDIS_URL=redis://redis:6379/0
# 业务库 PostgreSQL（SQLAlchemy 迁移后启用；当前业务库为 SQLite）
# DATABASE_URL=postgresql+psycopg://risk:risk@postgres:5432/risk

# ---- 前端静态（api 托管 SPA）----
RISK_WEB_DIST=/app/web/dist

# ---- 演示 ----
DEMO_MODE=1
# Streamlit 演示口令门禁（不设则不启用）
DEMO_PASSWORD=
