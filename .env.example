# 复制为 .env 后填写；程序只在需要时才读取对应变量

# ---- 数据源凭证 ----
CSMAR_USER=your_csmar_account
CSMAR_PASSWORD=your_csmar_password
QICHACHA_KEY=your_qichacha_api_key
TUSHARE_TOKEN=your_tushare_token

# ---- 运行参数 ----
LOG_LEVEL=INFO
DEMO_MODE=1          # 1=使用演示数据；0=使用 data/raw 下的真实数据
RANDOM_SEED=42

# ---- 代理（可选，用于爬虫）----
HTTP_PROXY=
HTTPS_PROXY=
